# Groq LLM
GROQ_API_KEY=

# Vector database (Chroma). Directory where vectors are persisted.
VECTOR_DB_PATH=./chroma_db

# Mem0 long-term memory
MEM0_API_KEY=
MEM0_API_URL=https://api.mem0.ai

# Optional: OpenAI / others (not required for this build)
# OPENAI_API_KEY=

# Admin control-plane auth. Required for /admin/* and /provenance/seal.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If left empty, control endpoints are disabled (fail-closed).
ADMIN_API_KEY=
# Local development only: allow admin endpoints with no key set. Never in prod.
ALLOW_INSECURE_DEV=false

# Logging
LOG_LEVEL=INFO

# Startup validation: when true, refuse to start if config.validate() reports problems.
STRICT=false